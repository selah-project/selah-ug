{"tier":"glm-5.2","verse":7,"ref":"2-samuel 19:7","book":"2-samuel","lang":"ug","chapter":19,"translation":"دۈشمەنلىرىڭنى ⟨את⟩ سۆيۈش ئۈچۈن، دوستلىرىڭنى ⟨את⟩ ياقتۇرماسلىق ئۈچۈن! چۈنكى بۈگۈن ئۆزۈڭنىڭ بېگىملىرىمۇ، خىزمەتچىلىرىمۇ ساڭا يوق ئىكەنلىكىنى ئېيتتىڭ. چۈنكى بۈگۈن بىلدىمكى: ئەگەر ئابشالوم تىرىك بولسا، بىزنىڭ ھەممىمىز بۈگۈن ئۆلگەن بولساق، ئۇ چاغدا كۆزۈڭگە توغرا بولاتتى.","tokens":[{"surface":"לאהבה","gloss":"سۆيۈش ئۈچۈن"},{"surface":"את","gloss":"⟨את⟩","marks":"دۈشمەنلىرىڭنى"},{"surface":"שנאיך","gloss":"دۈشمەنلىرىڭنى"},{"surface":"ולשנא","gloss":"ياقتۇرماسلىق ئۈچۈن"},{"surface":"את","gloss":"⟨את⟩","marks":"دوستلىرىڭنى"},{"surface":"אהביך","gloss":"دوستلىرىڭنى"},{"surface":"כי","gloss":"چۈنكى"},{"surface":"הגדת","gloss":"ئېيتتىڭ"},{"surface":"היום","gloss":"بۈگۈن"},{"surface":"כי","gloss":"كىيىنكىسى ئىكەنلىكىنى"},{"surface":"אין","gloss":"يوق"},{"surface":"לך","gloss":"ساڭا"},{"surface":"שרים","gloss":"بېگىملىرىمۇ"},{"surface":"ועבדים","gloss":"خىزمەتچىلىرىمۇ"},{"surface":"כי","gloss":"چۈنكى"},{"surface":"ידעתי","gloss":"بىلدىم"},{"surface":"היום","gloss":"بۈگۈن"},{"surface":"כי","gloss":"كىيىنكىسى: ئەگەر"},{"surface":"לא","gloss":"ئەگەر"},{"surface":"אבשלום","gloss":"ئابشالوم"},{"surface":"חי","gloss":"تىرىك بولسا"},{"surface":"וכלנו","gloss":"ھەممىمىز"},{"surface":"היום","gloss":"بۈگۈن"},{"surface":"מתים","gloss":"ئۆلگەن بولساق"},{"surface":"כי","gloss":"ئۇ چاغدا"},{"surface":"אז","gloss":"ئۇ چاغدا"},{"surface":"ישר","gloss":"توغرا بولاتتى"},{"surface":"בעיניך","gloss":"كۆزۈڭگە"}],"timestamp":"2026-09-16T21:27:26.098615385Z","model":"glm-5.3"}